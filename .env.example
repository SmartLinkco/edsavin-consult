# Public site URL, no trailing slash. Used for canonical links, Open Graph and the sitemap.
# Example: https://edsavin.example
NEXT_PUBLIC_SITE_URL=https://example.com

# Inbox that should receive enquiry form messages. Required before the form can deliver mail.
ENQUIRY_TO_EMAIL=

# Address the message is sent from. Required with either Resend or SMTP.
# For Resend this must be on a domain you have verified in Resend.
ENQUIRY_FROM_EMAIL=

# Option A — Resend (https://resend.com). Used when RESEND_API_KEY is set, even if SMTP is also set.
RESEND_API_KEY=

# Option B — any SMTP server. Used only when RESEND_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional. Google Analytics loads only when this is a Measurement ID such as G-XXXXXXXX.
# Leave it empty and Analytics stays off.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional. The meta tag Google Search Console gives you, content value only.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
